meta {
  name: Summary
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/admin/activity/summary
  body: none
  auth: none
}

params:query {
  ~window: 24h
  ~user: {{userId}}
  ~apiKey: {{apiKeyId}}
  ~index: {{indexId}}
}

docs {
  window is one of 24h, 7d, 30d (defaults server-side when omitted).
  user, apiKey and index narrow the activity; several combine with AND.
}
