meta {
  name: Recent Searches
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/admin/activity/recent
  body: none
  auth: none
}

params:query {
  ~window: 24h
  ~user: {{userId}}
  ~apiKey: {{personalKeyId}}
  ~index: {{indexId}}
  ~offset: 0
  ~limit: 100
  ~status: any
}

docs {
  status is one of any, success, error.
}
