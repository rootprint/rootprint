meta {
  name: Create Service Account Key
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/api-keys/service-account
  body: json
  auth: none
}

body:json {
  {
    "name": "agent-reader",
    "userId": "{{serviceAccountUserId}}"
  }
}

docs {
  Mints a read-only key for an existing service account (create one via
  service-accounts/Create Service Account first). The raw key is returned once.
}
