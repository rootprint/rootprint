meta {
  name: Search Logs
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/indexes/{{indexId}}/logs
  body: none
  auth: bearer
}

params:query {
  ~q: error
  ~limit: 50
  ~offset: 0
  ~startTs: 1700000000
  ~endTs: 1800000000
  ~sortOrder: desc
  ~countAll: true
}

auth:bearer {
  token: 
}

docs {
  numHits is the exact match count only with countAll=true; without it numHits
  is null, which skips counting splits that can't change the page. Readable
  with a session cookie or a personal key bearer token.
}
