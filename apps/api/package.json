{
	"name": "api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./types": {
			"types": "./src/types.ts",
			"default": "./src/types.ts"
		},
		"./schemas": {
			"types": "./src/schemas/index.ts",
			"default": "./src/schemas/index.ts"
		},
		"./constants": {
			"types": "./src/constants.ts",
			"default": "./src/constants.ts"
		},
		"./query": {
			"types": "./src/lib/quickwit/query.ts",
			"default": "./src/lib/quickwit/query.ts"
		},
		"./time": {
			"types": "./src/lib/time.ts",
			"default": "./src/lib/time.ts"
		}
	},
	"scripts": {
		"dev": "bun --hot src/app.ts",
		"build": "bun build src/app.ts --target=bun --outdir=dist --production --sourcemap=external",
		"check": "tsc -p tsconfig.json --noEmit",
		"lint": "oxlint",
		"test": "bun test",
		"start": "bun run dist/app.js",
		"openapi:generate": "bun scripts/generate-openapi.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"proto:gen": "buf generate"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.7.10",
		"@bufbuild/protobuf": "^2.16.0",
		"@modelcontextprotocol/server": "^2.3.1",
		"@rootprint-io/quickwit-js": "^0.5.1",
		"@valibot/to-json-schema": "^1.8.0",
		"better-auth": "^1.7.10",
		"dotenv": "^18.0.8",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.13",
		"hono-openapi": "^1.3.5",
		"hono-rate-limiter": "^0.5.4",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@bufbuild/buf": "^1.74.0",
		"@standard-schema/spec": "^1.1.0",
		"@bufbuild/protoc-gen-es": "^2.16.0",
		"@types/pg": "^8.23.1",
		"bun-types": "^1.4.3",
		"drizzle-kit": "^0.31.11"
	}
}
